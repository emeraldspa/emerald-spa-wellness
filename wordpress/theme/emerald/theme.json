{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "720px",
            "wideSize": "1200px"
        },
        "color": {
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                { "color": "#07211A", "name": "Ink", "slug": "ink" },
                { "color": "#F7F5F1", "name": "Ground", "slug": "ground" },
                { "color": "#EAF6F1", "name": "Cream", "slug": "cream" },
                { "color": "#C7E9DA", "name": "Mist", "slug": "mist" },
                { "color": "#087452", "name": "Emerald", "slug": "emerald" },
                { "color": "#0A5A45", "name": "Emerald Deep", "slug": "emerald-deep" },
                { "color": "#063F31", "name": "Emerald Dusk", "slug": "emerald-dusk" },
                { "color": "#F2C35E", "name": "Rose Gold", "slug": "rose-gold" },
                { "color": "#C77B36", "name": "Rose Gold Deep", "slug": "rose-gold-deep" },
                { "color": "#4F6B62", "name": "Muted", "slug": "muted" },
                { "color": "#D7E3DD", "name": "Hairline", "slug": "hairline" }
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Radley', 'Playfair Display', Georgia, serif",
                    "name": "Radley Display",
                    "slug": "display",
                    "fontFace": [
                        {
                            "fontFamily": "Radley",
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "src": ["file:./assets/fonts/radley-400.woff2"],
                            "fontDisplay": "swap"
                        }
                    ]
                },
                {
                    "fontFamily": "'Poppins', system-ui, -apple-system, 'Segoe UI', sans-serif",
                    "name": "Poppins Interface",
                    "slug": "interface",
                    "fontFace": [
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "src": ["file:./assets/fonts/poppins-400.woff2"],
                            "fontDisplay": "swap"
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "500",
                            "fontStyle": "normal",
                            "src": ["file:./assets/fonts/poppins-500.woff2"],
                            "fontDisplay": "swap"
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "600",
                            "fontStyle": "normal",
                            "src": ["file:./assets/fonts/poppins-600.woff2"],
                            "fontDisplay": "swap"
                        }
                    ]
                }
            ],
            "fontSizes": [
                { "fluid": { "min": "0.6875rem", "max": "0.75rem" }, "name": "Eyebrow", "size": "0.6875rem", "slug": "eyebrow" },
                { "fluid": { "min": "0.875rem", "max": "0.9375rem" }, "name": "Small", "size": "0.875rem", "slug": "small" },
                { "fluid": { "min": "1rem", "max": "1.0625rem" }, "name": "Medium", "size": "1rem", "slug": "medium" },
                { "fluid": { "min": "1.125rem", "max": "1.25rem" }, "name": "Large", "size": "1.125rem", "slug": "large" },
                { "fluid": { "min": "1.5rem", "max": "1.875rem" }, "name": "Extra Large", "size": "1.5rem", "slug": "x-large" },
                { "fluid": { "min": "2rem", "max": "2.75rem" }, "name": "Huge", "size": "2rem", "slug": "huge" },
                { "fluid": { "min": "2.75rem", "max": "4.5rem" }, "name": "Display", "size": "2.75rem", "slug": "display" }
            ]
        },
        "spacing": {
            "units": ["%", "px", "em", "rem", "vh", "vw"],
            "spacingSizes": [
                { "name": "XS", "size": "0.5rem", "slug": "xs" },
                { "name": "S", "size": "1rem", "slug": "s" },
                { "name": "M", "size": "1.5rem", "slug": "m" },
                { "name": "L", "size": "2.5rem", "slug": "l" },
                { "name": "XL", "size": "4rem", "slug": "xl" },
                { "name": "XXL", "size": "6.5rem", "slug": "xxl" }
            ]
        },
        "blocks": {
            "core/button": {
                "border": { "radius": true }
            },
            "core/image": {
                "border": { "radius": true }
            }
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--ground)",
            "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--interface)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.65"
        },
        "spacing": {
            "padding": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
            }
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontWeight": "400",
                    "lineHeight": "1.1",
                    "letterSpacing": "-0.022em"
                },
                "color": { "text": "var(--wp--preset--color--ink)" }
            },
            "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "0.98" } },
            "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
            "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
            "link": {
                "color": { "text": "var(--wp--preset--color--emerald-deep)" },
                "typography": { "textDecoration": "underline" },
                ":hover": {
                    "color": { "text": "var(--wp--preset--color--emerald)" },
                    "typography": { "textDecoration": "none" }
                }
            },
            "button": {
                "border": { "radius": "999px" },
                "color": {
                    "background": "var(--wp--preset--color--emerald-deep)",
                    "text": "#FDFCF9"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--interface)",
                    "fontSize": "0.75rem",
                    "fontWeight": "600",
                    "letterSpacing": "0.14em",
                    "textTransform": "uppercase",
                    "textDecoration": "none"
                },
                "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.75rem", "right": "1.75rem" } },
                ":hover": {
                    "color": { "background": "var(--wp--preset--color--emerald-dusk)", "text": "#FDFCF9" }
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--interface)",
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "fontWeight": "600"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--interface)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "500"
                }
            },
            "core/quote": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)"
                }
            }
        }
    },
    "templateParts": [
        { "area": "header", "name": "header", "title": "Header" },
        { "area": "footer", "name": "footer", "title": "Footer" }
    ],
    "customTemplates": [
        { "name": "page-full", "postTypes": ["page"], "title": "Page, full width" },
        { "name": "page-plain", "postTypes": ["page"], "title": "Page, plain" }
    ]
}
